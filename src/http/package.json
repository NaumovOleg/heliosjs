{
  "name": "@heliosjs/http",
  "version": "11.0.1",
  "description": "Http server support for @heliosjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NaumovOleg/heliosjs.git",
    "directory": "src/http"
  },
  "files": [
    "dist/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "yarn clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "publish:public": "yarn publish --access public --no-git-tag-version",
    "publish:patch": "yarn version --patch --no-git-tag-version && yarn publish --access public",
    "publish:minor": "yarn version --minor --no-git-tag-version && yarn publish --access public",
    "publish:major": "yarn version --major --no-git-tag-version && yarn publish --access public"
  },
  "peerDependencies": {
    "@heliosjs/core": ">=4.0.2",
    "typescript": ">=5.0.0",
    "reflect-metadata": "^0.2.2",
    "@types/node": ">=20.0.0",
    "ws": "^8.19.0",
    "graphql-yoga": "^5.18.1",
    "type-graphql": "^2.0.0-rc.3",
    "graphql-ws": "^6.0.7"
  },
  "peerDependenciesMeta": {
    "graphql-yoga": {
      "optional": true
    },
    "type-graphql": {
      "optional": true
    },
    "graphql-ws": {
      "optional": true
    }
  }
}
