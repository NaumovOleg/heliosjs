oach to define GraphQL schemas, resolvers, and subscriptions.","source":"@site/docs/http-module/graph-ql.md","sourceDirName":"http-module","slug":"/http-module/graph-ql","permalink":"/helios/docs/http-module/graph-ql","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":10,"frontMatter":{"sidebar_position":10},"sidebar":"tutorialSidebar","previous":{"title":"Server-Sent Events (SSE)","permalink":"/helios/docs/http-module/server-sent-events"},"next":{"title":"Custom Plugins","permalink":"/helios/docs/http-module/plugins"}},{"id":"http-module/plugins","title":"Custom Plugins","description":"Plugins hook into the server lifecycle to add reusable functionality like logging, metrics, database connections, or authentication.","source":"@site/docs/http-module/plugins.md","sourceDirName":"http-module","slug":"/http-module/plugins","permalink":"/helios/docs/http-module/plugins","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":11,"frontMatter":{"sidebar_position":11},"sidebar":"tutorialSidebar","previous":{"title":"GraphQL Module in Helios","permalink":"/helios/docs/http-module/graph-ql"},"next":{"title":"AWS Lambda Integration","permalink":"/helios/docs/aws/lambda-integration"}},{"id":"http-module/server","title":"HTTP Server","description":"The @Server decorator configures your HTTP server, and the Helios class starts and manages it.","source":"@site/docs/http-module/server.md","sourceDirName":"http-module","slug":"/http-module/server","permalink":"/helios/docs/http-module/server","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":7,"frontMatter":{"sidebar_position":7},"sidebar":"tutorialSidebar","previous":{"title":"Fingerprint Decorator","permalink":"/helios/docs/middlewares/fingerprint"},"next":{"title":"WebSocket","permalink":"/helios/docs/http-module/websockets"}},{"id":"http-module/server-sent-events","title":"Server-Sent Events (SSE)","description":"SSE pushes real-time updates from server to client over HTTP. Unlike WebSocket, SSE is unidirectional (server → client) and works over standard HTTP.","source":"@site/docs/http-module/server-sent-events.md","sourceDirName":"http-module","slug":"/http-module/server-sent-events","permalink":"/helios/docs/http-module/server-sent-events","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":9,"frontMatter":{"sidebar_position":9},"sidebar":"tutorialSidebar","previous":{"title":"WebSocket","permalink":"/helios/docs/http-module/websockets"},"next":{"title":"GraphQL Module in Helios","permalink":"/helios/docs/http-module/graph-ql"}},{"id":"http-module/websockets","title":"WebSocket","description":"HeliosJS provides decorator-driven WebSocket support with topic pub/sub, broadcasting, and client management.","source":"@site/docs/http-module/websockets.md","sourceDirName":"http-module","slug":"/http-module/websockets","permalink":"/helios/docs/http-module/websockets","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":8,"frontMatter":{"sidebar_position":8},"sidebar":"tutorialSidebar","previous":{"title":"HTTP Server","permalink":"/helios/docs/http-module/server"},"next":{"title":"Server-Sent Events (SSE)","permalink":"/helios/docs/http-module/server-sent-events"}},{"id":"intro","title":"Intro","description":"Welcome to HeliosJS! A decorator-first Node.js framework for building REST APIs, WebSocket servers, and serverless functions with TypeScript.","source":"@site/docs/intro.md","sourceDirName":".","slug":"/intro","permalink":"/helios/docs/intro","draft":false,"unlisted":false,"tags":[],"version":"current","sidebarPosition":1,"frontMatter":{"sidebar_position":1},"sidebar":"tutorialSidebar","next":{"title":"Installation & Setup","permalink":"/helios/docs/core-module/installation"}},{"id":"middlewares/basics","title":"Middleware Decorators Basics","description":"This document provides an overview of the middleware decorators available in the HeliosJS framework. Middleware decorators allow you to apply reusable logic such as error handling, CORS configuration, guards, interceptors, pipes, sanitization, and general middleware functions at the controller or method level.","source":"@site/docs/middlewares/basics.md","sourceDirName":"middlewares","slug":"/middlewares/basics","permalink":"/helios/docs/middlewares/basics","draft":false,"unlisted":false,"tags":[],"version":"current","frontMatter":{}},{"id":"middlewares/catch","title":"Catch Middleware Decorator","description":"The @Catch decorator registers error handlers at the controller or method level.","source":"@site/docs/middlewares/catch.md","sourceDirName":"middlewares","slug":"/middlewares/catch","permalink":"/helios/docs/middlewares/catch","draft":false,"unlisted":false,"tags":[],"version":"current","frontMatter":{},"sidebar":"tutorialSidebar","previous":{"title":"Use Middleware Decorator","permalink":"/helios/docs/middlewares/use"},"next":{"title":"Intercept Middleware Decorator","permalink":"/helios/docs/middlewares/intercept"}},{"id":"middlewares/cors","title":"Cors Middleware Decorator","description":"The @Cors decorator configures Cross-Origin Resource Sharing (CORS) for controllers or methods.","source":"@site/docs/middlewares/cors.md","sourceDirName":"middlewares","slug":"/middlewares/cors","permalink":"/helios/docs/middlewares/cors","draft":false,"unlisted":false,"tags":[],"version":"current","frontMatter":{},"sidebar":"tutorialSidebar","previous":{"title":"Sanitize Middleware Decorator","permalink":"/helios/docs/middlewares/sanitize"},"next":{"title":"Guard Decorator","permalink":"/helios/docs/middlewares/guard"}},{"id":"middlewares/fingerprint","title":"Fingerprint Decorator","description":"Request fingerprinting derives a stable identifier from request attributes (client IP, User-Agent, headers), hashes it, and exposes it to your application. HeliosJS provides two complementary decorators:","source":"@site/docs/middlewares/fingerprint.md","sourceDirName":"mid