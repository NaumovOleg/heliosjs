{
  "name": "heliosjs",
  "version": "1.0.0",
  "description": "Decorator-based API framework",
  "main": "dist/index.js",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=20.0.0"
  },
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "yarn build:core && yarn build:http && yarn build:aws && yarn build:middlewares && yarn build:grpc",
    "build:core": "yarn workspace @heliosjs/core run build",
    "build:http": "yarn workspace @heliosjs/http run build",
    "build:aws": "yarn workspace @heliosjs/aws run build",
    "build:grpc": "yarn workspace @heliosjs/grpc run build",
    "build:middlewares": "yarn workspace @heliosjs/middlewares run build",
    "dev": "nodemon --config ./nodemon.json",
    "link-packages": "chmod +x ./setup-symlinks.sh && ./setup-symlinks.sh",
    "make-tag": "changeset tag",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "version-packages": "changeset version",
    "release": "changeset publish --provenance --access public",
    "lint": "npx eslint --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "docs:start": "yarn workspace docs start",
    "docs:build": "yarn workspace docs build",
    "docs:serve": "yarn workspace docs serve",
    "benchmark:build": "cd benchmarks && npx tsc -p tsconfig.json --skipLibCheck",
    "benchmark": "yarn benchmark:build && node benchmarks/dist/run.js",
    "benchmark:soak": "yarn benchmark:build && node benchmarks/dist/soak.js",
    "benchmark:middleware": "yarn benchmark:build && node benchmarks/dist/run-middleware.js",
    "benchmark:validation": "yarn benchmark:build && node benchmarks/dist/run-validation.js",
    "benchmark:serialize": "yarn benchmark:build && node benchmarks/dist/run-serialize.js"
  },
  "workspaces": [
    "src/core",
    "src/middlewares",
    "src/http",
    "src/aws",
    "src/grpc",
    "helios-docs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NaumovOleg/heliosjs"
  },
  "keywords": [
    "api",
    "decorators",
    "http",
    "rest",
    "websocket",
    "typescript",
    "aws",
    "lambda",
    "graphql",
    "grpc"
  ],
  "author": "Naumov Oleh",
  "devDependencies": {
    "@changesets/cli": "2.30.0",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "10.0.1",
    "@mdx-js/react": "^3.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@types/autocannon": "^7.12.7",
    "@types/aws-lambda": "8.10.161",
    "@types/node": "25.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "^4",
    "ajv": "8.20.0",
    "autocannon": "^7.15.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "clsx": "^2.0.0",
    "conventional-changelog-conventionalcommits": "9.3.0",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-unused-imports": "4.4.1",
    "express": "^4.21.0",
    "fastify": "^5.1.0",
    "gh-pages": "^6.3.0",
    "globals": "17.6.0",
    "graphql": "16.13.1",
    "graphql-scalars": "1.25.0",
    "graphql-ws": "6.0.7",
    "graphql-yoga": "5.18.1",
    "joi": "18.2.9",
    "nodemon": "3.1.14",
    "parse-multipart-data": "1.5.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "reflect-metadata": "0.2.2",
    "sanitize-html": "2.17.7",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "^4.19.0",
    "type-graphql": "2.0.0-rc.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.59.1",
    "vitest": "^4.1.9",
    "ws": "8.21.3"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "rxjs": "7.8.2"
  },
  "resolutions": {
    "@grpc/grpc-js": "1.14.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "parse-multipart-data": "1.5.0",
    "protobufjs": "7.6.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "type-graphql": "2.0.0-rc.3",
    "ws": "8.21.3"
  }
}
